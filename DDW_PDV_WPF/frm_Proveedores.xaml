<Page x:Class="DDW_PDV_WPF.frm_Proveedores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDW_PDV_WPF"
        mc:Ignorable="d"
        Title="frm_Proveedores" Height="650" Width="900">

    <Page.Resources>
        <Style TargetType="ListBoxItem">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f0f0f0" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#d0d0d0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="MinHeight" Value="35" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E5C1DC" />
        </Style>

        <Style x:Key="CustomGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#6B9D89" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="white" />
            <Setter Property="Margin" Value="0,0,0,15" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Margin="10,0,10,0" Padding="5,0,5,0" Background="#6B9D89">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextBlock.FontWeight="Bold" />
                                </Border>
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="9*" />
            <RowDefinition Height="662*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*" MinWidth="300" />
            <ColumnDefinition Width="0.6*" MinWidth="450" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="1" Grid.Column="0" Margin="10,1,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" Foreground="#2E5E4E" Text="PROVEEDORES"/>

            <Border Grid.Row="0" Margin="0,0,0,10" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <TextBox x:Name="txtBusqueda" Padding="10" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#333333" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Padding="15,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontStyle="Italic" Foreground="Gray" Text="Buscar proveedor..." Visibility="{Binding TextoBusqueda, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=inverse}" />
                    <Button x:Name="btnClearSearch" Width="20" Height="20" Margin="0,0,10,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Command="{Binding LimpiarBusquedaCommand}" Content="✕" FontSize="12" Foreground="Gray" Visibility="{Binding TextoBusqueda, Converter={StaticResource StringToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#F1E6D3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <ListBox x:Name="lstProveedores" HorizontalContentAlignment="Stretch" ItemsSource="{Binding ListaProveedores}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItem="{Binding ProveedorSeleccionado, Mode=TwoWay}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#f0f0f0" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#d0d0d0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" Padding="5" Background="white" BorderBrush="white" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding Nombre}" TextWrapping="Wrap" Foreground="#2E5E4E"/>
                                    <TextBlock FontSize="12" Foreground="#666666" Text="{Binding Estado, StringFormat='Estado: {0}'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,15" HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style x:Key="TextButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="#767676" />
                        <Setter Property="FontSize" Value="20" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="ContentText" Padding="8,4" Text="{TemplateBinding Content}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextDecorations" Value="None" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Foreground" Value="#A01A7D" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <Button x:Name="BotonAgregar1" Margin="0,0,20,0" Click="BotonAgregar" Content="+  Agregar" Foreground="Green" Style="{StaticResource TextButtonStyle}" />
                <Button x:Name="BotonQuitar1" Click="EliminarProveedor" Content="−   Quitar" Foreground="Red" Style="{StaticResource TextButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Margin="10,1,10,10" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="15">
            <Grid DataContext="{Binding ProveedorSeleccionado}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Detalles del Proveedor" FontSize="22" FontWeight="Bold" Foreground="#2E5E4E" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <Grid Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="150" Height="150" Margin="0,0,20,0" Background="#E5C1DC" CornerRadius="5">
                                <Grid>
                                    <Image Margin="5" Source="{Binding ImagenProveedor, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                    <Button x:Name="BtnCambiarImagen" Width="28" Height="28" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Content="📷" FontSize="12" ToolTip="Cambiar foto" Click="BtnSeleccionarImagen_Click" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,15" MinHeight="60" HorizontalAlignment="Stretch">
                                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#2E5E4E" Text="{Binding Nombre, TargetNullValue='[ El nombre aparecerá aquí ]'}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Border>

                                <Button x:Name="btnToggleEstado" Click="btnToggleEstado_Click" Padding="41,10" FontSize="16" FontWeight="Bold" HorizontalAlignment="center" Cursor="Hand" BorderThickness="0" Content="{Binding Estado, TargetNullValue='Activo'}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#D4EDDA" />
                                            <Setter Property="Foreground" Value="#155724" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Estado}" Value="Inactivo">
                                                    <Setter Property="Background" Value="#F8D7DA" />
                                                    <Setter Property="Foreground" Value="#721C24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <GroupBox Grid.Row="1" Header="Nombre del Proveedor" Style="{StaticResource CustomGroupBoxStyle}">
                            <TextBox Style="{StaticResource DetailTextBoxStyle}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Email (Correo Electrónico)" Style="{StaticResource CustomGroupBoxStyle}">
                            <TextBox Style="{StaticResource DetailTextBoxStyle}" Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" />
                        </GroupBox>

                        <GroupBox Grid.Row="3" Header="Teléfono" Style="{StaticResource CustomGroupBoxStyle}">
                            <TextBox Style="{StaticResource DetailTextBoxStyle}" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />
                        </GroupBox>

                        <GroupBox Grid.Row="4" Header="Dirección" Style="{StaticResource CustomGroupBoxStyle}" Margin="0,0,0,5">
                            <TextBox MinHeight="45" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource DetailTextBoxStyle}" Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" />
                        </GroupBox>

                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button x:Name="btnGuardarCambios" Width="100" Height="35" Margin="0,0,15,0" Background="#6B9D89" BorderThickness="0" Click="GuardarCambios" Content="Guardar" Foreground="White" />
                        <Button x:Name="btnCancelarCambios" Width="100" Height="35" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Click="Cancelar_Click" Content="Cancelar" />
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="btnEditar" Width="100" Height="35" Background="#2E5E4E" Foreground="White" BorderThickness="0" Cursor="Hand" Click="btnEditar_Click" Content="EDITAR" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Page>