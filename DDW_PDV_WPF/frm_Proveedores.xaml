<Page
    x:Class="DDW_PDV_WPF.frm_Proveedores"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DDW_PDV_WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="frm_Proveedores"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="1000">

    <Page.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="MinHeight" Value="35" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E5C1DC" />
        </Style>

        <Style x:Key="CustomGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#6B9D89" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="white" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Margin="10,0,10,0" Padding="5,0,5,0" Background="#6B9D89" HorizontalAlignment="Stretch">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextBlock.FontWeight="Bold" />
                                </Border>
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:EstadoToColorConverter x:Key="EstadoColor" />
    </Page.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" MinWidth="350" MaxWidth="500"/>
            <ColumnDefinition Width="6*" MinWidth="450" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10,15,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Margin="0,0,0,10" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <TextBox x:Name="txtBusqueda" Padding="10" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#333333" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Padding="15,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontStyle="Italic" Foreground="Gray" Text="Buscar proveedor..." Visibility="{Binding TextoBusqueda, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=inverse}" />
                    <Button x:Name="btnClearSearch" Width="20" Height="20" Margin="0,0,10,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Command="{Binding LimpiarBusquedaCommand}" Content="✕" FontSize="12" Foreground="Gray" Visibility="{Binding TextoBusqueda, Converter={StaticResource StringToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#F1E6D3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <ListBox x:Name="lstProveedores" HorizontalContentAlignment="Stretch" ItemsSource="{Binding ListaProveedores}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItem="{Binding ProveedorSeleccionado, Mode=TwoWay}" Padding="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5,5,15,10" Padding="15" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#6B9D89" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#F8F9FA" BorderBrush="#E5C1DC" BorderThickness="1" Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="Account" Width="22" Height="22" Foreground="#6B9D89" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="#333333" Text="{Binding Nombre}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Height="1" Background="#F0F0F0" Margin="0,10,0,10" />

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <materialDesign:PackIcon Kind="EmailOutline" Width="14" Height="14" Foreground="#999999" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="13" Foreground="#666666" Text="{Binding Correo}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="PhoneOutline" Width="14" Height="14" Foreground="#999999" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="13" Foreground="#666666" Text="{Binding Telefono, StringFormat='Tel: {0}'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" VerticalAlignment="Bottom" Background="{Binding Estado, Converter={StaticResource EstadoColor}}" CornerRadius="4" Padding="8,4">
                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding Estado}" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,15" HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style x:Key="TextButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="#767676" />
                        <Setter Property="FontSize" Value="20" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Padding="8,4" Text="{TemplateBinding Content}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Foreground" Value="#A01A7D" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="BotonAgregar1" Margin="0,0,20,0" Content="+  Agregar" Foreground="Green" Style="{StaticResource TextButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Margin="10,15,10,10" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="20">
            <Grid DataContext="{Binding ProveedorSeleccionado}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,10" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8" Padding="15" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="195" Height="195" Margin="0,0,25,0" Background="#E5C1DC" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid>
                                <Viewbox Margin="10" Stretch="Fill">
                                    <Image Margin="5" Source="{Binding ImagenProveedor, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                </Viewbox>
                                <Button x:Name="btnSeleccionarImagen" Click="BtnSeleccionarImagen_Click" Width="32" Height="32" Margin="8" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Content="📷" FontSize="14" ToolTip="Cambiar imagen" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <Border Background="#E6E8EA" CornerRadius="5" Padding="10,5" Margin="0,0,0,15" MinHeight="55" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding Nombre}" FontSize="28" FontWeight="Bold" Foreground="#333333" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>

                            <Button x:Name="btnToggleEstado" 
                              Content="{Binding Estado}" 
                              Width="110" MinHeight="35" HorizontalAlignment="Center" 
                              Background="{Binding Estado, Converter={StaticResource EstadoColor}, FallbackValue='#6B9D89'}" 
                              Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,15">
                    <GroupBox Header="Nombre del Proveedor" Style="{StaticResource CustomGroupBoxStyle}">
                        <TextBox Style="{StaticResource DetailTextBoxStyle}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.HasChanges, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </GroupBox>

                    <GroupBox Header="EMAIL (Correo Elctronico)" Style="{StaticResource CustomGroupBoxStyle}">
                        <TextBox Style="{StaticResource DetailTextBoxStyle}" Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.HasChanges, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </GroupBox>

                    <GroupBox Header="Telefono" Style="{StaticResource CustomGroupBoxStyle}">
                        <TextBox Style="{StaticResource DetailTextBoxStyle}" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.HasChanges, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </GroupBox>

                    <GroupBox Header="Direccíon" Style="{StaticResource CustomGroupBoxStyle}">
                        <TextBox Style="{StaticResource DetailTextBoxStyle}" Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.HasChanges, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </GroupBox>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,15,0,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="btnGuardarCambios" Width="110" Height="38" Margin="0,0,10,0" Background="#6B9D89" Foreground="White" FontWeight="Bold" BorderThickness="0" Content="Guardar" Cursor="Hand" />
                        <Button x:Name="btnCancelarCambios" Width="110" Height="38" Background="White" BorderBrush="#CCCCCC" BorderThickness="2" Foreground="#666666" FontWeight="Bold" Content="Cancelar" Cursor="Hand" />
                    </StackPanel>

                    <Button x:Name="btnEditar" Grid.Column="2" Width="120" Height="38" Background="#6B9D89" Foreground="White" FontWeight="Bold" BorderThickness="0" Content="EDITAR" Cursor="Hand"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Page>