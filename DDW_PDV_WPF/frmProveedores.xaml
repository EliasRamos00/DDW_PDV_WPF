<Page
    x:Class="DDW_PDV_WPF.frmProveedores"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Carga desde PDF"
    Background="#6B9D89">

    <Grid Margin="10" Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- =========================
             ENCABEZADO
             ========================= -->
        <Grid Grid.Row="0" Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- PDF -->
            <StackPanel Grid.Column="0">

                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="PDF" />

                <ComboBox
                    x:Name="cbPDF"
                    Height="32"
                    SelectionChanged="cbPDF_SelectionChanged">

                    <ComboBoxItem Content="Seleccionar PDF" />

                </ComboBox>

            </StackPanel>

            <!-- PROVEEDOR -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0">

                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Proveedor" />

                <ComboBox
                    x:Name="cbProveedor"
                    Height="32"
                    DisplayMemberPath="Nombre"
                    ItemsSource="{Binding Proveedores}"
                    SelectedIndex="0" />

            </StackPanel>

        </Grid>

        <!-- =========================
             ALTA MANUAL
             ========================= -->
        <Border
            Grid.Row="1"
            Margin="10,0,10,10"
            Padding="10"
            Background="#F5F5F5"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="4">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <!-- Cantidad -->
                <StackPanel Grid.Column="0">

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="Bold"
                        Text="Cant." />

                    <TextBox
                        x:Name="txtCantidadManual"
                        Height="30"
                        Text="1" />

                </StackPanel>

                <!-- Artículo -->
                <StackPanel Grid.Column="1" Margin="10,0">

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="Bold"
                        Text="Artículo" />

                    <ComboBox
                        x:Name="cbArticuloManual"
                        Height="30"
                        DisplayMemberPath="Descripcion"
                        ItemsSource="{Binding ListaArticulos}"
                        SelectedIndex="0"
                        SelectionChanged="cbArticuloManual_SelectionChanged"
                        />

                </StackPanel>

                <!-- Precio -->
                <StackPanel Grid.Column="2" Margin="10,0">

                    <TextBlock
                        Margin="0,0,0,5"
                        FontWeight="Bold"
                        Text="Precio" />

                    <TextBox
                        x:Name="txtPrecioManual"
                        Height="30"
                        Text="0.00" />

                </StackPanel>

                <!-- Botón -->
                <Button
                    Grid.Column="3"
                    Margin="10,22,0,0"
                    Height="35"
                    Background="#6B9D89"
                    BorderThickness="0"
                    Click="btnAgregarArticulo_Click"
                    Content="Agregar"
                    FontWeight="Bold"
                    Foreground="White" />

            </Grid>

        </Border>

        <!-- =========================
             TABLAS
             ========================= -->
        <ScrollViewer
            Grid.Row="2"
            CanContentScroll="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <!-- TABLA PDF -->
                <Border
                    Grid.Column="0"
                    Margin="5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">

                    <DataGrid
                        AutoGenerateColumns="False"
                        Background="#FAFAFA"
                        CanUserAddRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="False"
                        CanUserSortColumns="False"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding ProductosPdf}"
                        PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Cantidad}"
                                Header="Cantidad" />

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Codigo}"
                                Header="Código Proveedor" />

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

                <!-- TABLA SISTEMA -->
                <Border
                    Grid.Column="1"
                    Margin="5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">

                    <DataGrid
                        AutoGenerateColumns="False"
                        Background="#FAFAFA"
                        CanUserAddRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="False"
                        CanUserSortColumns="False"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding ArticulosEncontrados}"
                        PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Descripcion}" Value="NO ENCONTRADO">
                                        <Setter Property="Background" Value="#FFD6D6" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Descripcion}" Value="ERROR">
                                        <Setter Property="Background" Value="#FFD6D6" />
                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Cantidad}"
                                Header="Cantidad" />

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Descripcion}"
                                Header="Artículo" />

                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding PrecioCompra}"
                                Header="Precio" />

                            <DataGridTemplateColumn 
                                Width="75"                                
                                >

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button
                                            Content="X"
                                            Padding="0"
                                            Margin="0"
                                            Width="40"
                                            Height="25"
                                            Background="Red"
                                            Foreground="White"
                                            Click="btnEliminarArticulo_Click"/>     


                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </ScrollViewer>

        <!-- =========================
             PIE
             ========================= -->
        <Border
            Grid.Row="3"
            Padding="10"
            Background="#F5F5F5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="Total compra:" />

                <TextBox
                    x:Name="txtBTotalCompra"
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="0.00" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">

                    <Button
                        Width="120"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="#4F7D6A"
                        BorderThickness="0"
                        Click="btnRefrescar_Click"
                        Content="Refrescar"
                        Foreground="White" />

                    <Button
                        Width="150"
                        Height="38"
                        Background="#6B9D89"
                        BorderThickness="0"
                        Content="Cargar Compra"
                        Cursor="Hand"
                        Click="CargarCompra_Click"
                        FontWeight="Bold"
                        Foreground="White" />

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Page>