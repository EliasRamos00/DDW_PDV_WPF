<Page x:Class="DDW_PDV_WPF.frmProveedores"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DDW_PDV_WPF"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Carga desde PDF"
      Width="1000"
      Height="600"
      Background="#6B9D89">

    <!-- Contenedor blanco general -->
    <Grid Margin="10" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezados PDF / Sistema -->
        <Grid Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PDF -->
            <StackPanel Grid.Column="0">
                <Label Content="PDF"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,5"/>
                <ComboBox
                    x:Name="cbPDF"
                    SelectionChanged="cbPDF_SelectionChanged"
                    >
                    
                    <ComboBoxItem Content="Seleccionar PDF"/>
                </ComboBox>
            </StackPanel>

            <!-- Sistema -->
            <StackPanel Grid.Column="1">
                <Label Content="Sistema"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,5"/>
            </StackPanel>
        </Grid>

        <!-- TABLA ÚNICA DE COMPARACIÓN -->
        <DataGrid Grid.Row="1"
                  Margin="5"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="#F2F2F2"
                  HeadersVisibility="Column">

            <DataGrid.Columns>

                <!-- PDF -->
                <DataGridTextColumn Header="Cant. PDF"
                                    Width="80"
                                    Binding="{Binding CantidadPdf}" />

                <DataGridTextColumn Header="Código / Nombre PDF"
                                    Width="*"
                                    Binding="{Binding NombrePdf}" />

                <!-- Separador visual -->
                <DataGridTextColumn Header=""
                                    Width="20"
                                    IsReadOnly="True" />

                <!-- SISTEMA -->
                <DataGridTextColumn Header="Cant. Sistema"
                                    Width="80"
                                    Binding="{Binding CantidadSistema}" />

                <DataGridTextColumn Header="Código / Nombre Sistema"
                                    Width="*"
                                    Binding="{Binding NombreSistema}" />

            </DataGrid.Columns>
        </DataGrid>

        <!-- Botón Cargar -->
        <Button Grid.Row="2"
                Width="120"
                Height="35"
                Margin="5"
                HorizontalAlignment="Right"
                Background="#6B9D89"
                BorderBrush="#6B9D89"
                FontWeight="Bold"
                Content="Cargar"/>
    </Grid>
</Page>
