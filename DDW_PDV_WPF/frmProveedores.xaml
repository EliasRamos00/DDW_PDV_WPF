<Page
    x:Class="DDW_PDV_WPF.frmProveedores"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Carga desde PDF"
    Background="#6B9D89">

    <Grid Margin="10" Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            =========================
            ENCABEZADO
            ==========================
        -->
        <Grid Grid.Row="0" Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  PDF  -->
            <StackPanel Grid.Column="0">

                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="PDF" />

                <ComboBox
                    x:Name="cbPDF"
                    Height="32"
                    SelectionChanged="cbPDF_SelectionChanged">

                    <ComboBoxItem Content="Seleccionar PDF" />

                </ComboBox>

            </StackPanel>

            <!--  PROVEEDOR  -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0">

                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Proveedor" />

                <ComboBox
                    x:Name="cbProveedor"
                    Height="32"
                    SelectedIndex="0">

                    <ComboBoxItem Content="VIABELLA INT'L INC." Tag="1" />
                    <ComboBoxItem Content="Proveedor 2" Tag="2" />
                    <ComboBoxItem Content="Proveedor 3" Tag="3" />

                </ComboBox>

            </StackPanel>

        </Grid>

        <!--
            =========================
            TABLAS
            ==========================
        -->
        <ScrollViewer
            Grid.Row="1"
            CanContentScroll="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <!--  ===== TABLA PDF =====  -->
                <Border
                    Grid.Column="0"
                    Margin="5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">

                    <DataGrid
                        AutoGenerateColumns="False"
                        Background="#FAFAFA"
                        CanUserAddRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="False"
                        CanUserSortColumns="False"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding ProductosPdf}"
                        PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Cantidad}"
                                Header="Cantidad" />

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Codigo}"
                                Header="Código Proveedor" />

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

                <!--  ===== TABLA SISTEMA =====  -->
                <Border
                    Grid.Column="1"
                    Margin="5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">

                    <DataGrid
                        AutoGenerateColumns="False"
                        Background="#FAFAFA"
                        CanUserAddRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="False"
                        CanUserSortColumns="False"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding ArticulosEncontrados}"
                        PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Descripcion}" Value="NO ENCONTRADO">
                                        <Setter Property="Background" Value="#FFD6D6" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Descripcion}" Value="ERROR">
                                        <Setter Property="Background" Value="#FFD6D6" />
                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Cantidad}"
                                Header="Cantidad" />

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Descripcion}"
                                Header="Artículo" />

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </ScrollViewer>

        <!--
            =========================
            PIE
            ==========================
        -->
        <Border
            Grid.Row="2"
            Padding="10"
            Background="#F5F5F5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  TOTAL  -->
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="Total compra:" />

                <TextBox
                    x:Name="txtBTotalCompra"
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="0.00" />

                <!--  BOTONES  -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">

                    <Button
                        Width="120"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="#4F7D6A"
                        BorderThickness="0"
                        Click="btnRefrescar_Click"
                        Content="Refrescar"
                        Foreground="White" />

                    <Button
                        Width="150"
                        Height="38"
                        Background="#6B9D89"
                        BorderThickness="0"
                        Content="Cargar Compra"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White" />

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Page>