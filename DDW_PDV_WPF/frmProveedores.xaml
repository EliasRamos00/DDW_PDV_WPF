<Page
    x:Class="DDW_PDV_WPF.frmProveedores"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Carga desde PDF"
    Width="1000"
    Height="600"
    Background="#6B9D89">

    <Grid Margin="10" Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ENCABEZADOS  -->
        <Grid Grid.Row="0" Margin="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  PDF  -->
            <StackPanel Grid.Column="0">

                <Label
                    Margin="0,0,0,5"
                    Content="PDF"
                    FontSize="14"
                    FontWeight="Bold" />

                <ComboBox
                    x:Name="cbPDF"
                    Width="250"
                    SelectionChanged="cbPDF_SelectionChanged">

                    <ComboBoxItem Content="Seleccionar PDF" />

                </ComboBox>

            </StackPanel>

            <!--  PROVEEDOR + REFRESCAR  -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <StackPanel>
                    <Label
                        Margin="0,0,0,5"
                        Content="Proveedor"
                        FontSize="14"
                        FontWeight="Bold" />

                    <ComboBox
                        x:Name="cbProveedor"
                        Width="120"
                        SelectedIndex="0">

                        <ComboBoxItem Content="1" />

                    </ComboBox>
                </StackPanel>

                <Button
                    Width="100"
                    Height="28"
                    Margin="15,25,0,0"
                    Background="#6B9D89"
                    BorderThickness="0"
                    Click="btnRefrescar_Click"
                    Content="Refrescar"
                    Cursor="Hand"
                    FontWeight="Bold"
                    Foreground="White" />

            </StackPanel>

        </Grid>

        <!--  TABLAS  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <Grid Margin="5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  TABLA PDF  -->
                <DataGrid
                    Grid.Column="0"
                    Margin="5"
                    AutoGenerateColumns="False"
                    Background="#F2F2F2"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding ProductosPdf}"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Cantidad}"
                            Header="Cantidad PDF" />

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Codigo}"
                            Header="Código PDF" />

                    </DataGrid.Columns>

                </DataGrid>

                <!--  TABLA SISTEMA  -->
                <DataGrid
                    Grid.Column="1"
                    Margin="5"
                    AutoGenerateColumns="False"
                    Background="#F2F2F2"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding ArticulosEncontrados}"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding idArticulo}"
                            Header="Código Sistema" />

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </ScrollViewer>

    </Grid>
</Page>